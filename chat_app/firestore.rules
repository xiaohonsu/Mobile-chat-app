rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───────────────────────────────────────────────
    match /users/{uid} {
      // Đọc: chỉ user đã đăng nhập
      allow read: if request.auth != null;

      // Ghi: chỉ user đó mới được sửa profile của mình
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Chat Rooms ──────────────────────────────────────────
    match /chats/{chatId} {
      // Đọc/ghi: chỉ members của chat room đó
      allow read, write: if request.auth != null
          && request.auth.uid in resource.data.memberIds;

      // Tạo chat room mới: phải include chính mình là member
      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.memberIds;

      // ─── Messages (subcollection) ─────────────────────────
      match /messages/{messageId} {
        // Đọc: chỉ members của chat room
        allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;

        // Gửi message: phải là member VÀ senderId phải là uid của chính mình
        allow create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
            && request.resource.data.senderId == request.auth.uid;

        // Update status (seen/delivered): chỉ members
        allow update: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;

        // Không cho phép xóa message
        allow delete: if false;
      }
    }
  }
}
